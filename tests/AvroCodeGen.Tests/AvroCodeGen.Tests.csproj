<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvroCodeGen\AvroCodeGen.csproj" />
    <ProjectReference Include="..\..\src\AvroCodeGen.Cli\AvroCodeGen.Cli.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <CliDll>$(MSBuildThisFileDirectory)../../src/AvroCodeGen.Cli/bin/$(Configuration)/$(TargetFramework)/AvroCodeGen.Cli.dll</CliDll>
    <GenDir>$(MSBuildProjectDirectory)/obj/generated</GenDir>
  </PropertyGroup>

  <!-- Generate C# from the sample and test schemas with the CLI so the tests exercise real generated code. -->
  <Target Name="GenerateAvro" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <RemoveDir Directories="$(GenDir)" />
    <Exec Command="dotnet &quot;$(CliDll)&quot; generate -s &quot;$(MSBuildThisFileDirectory)../../samples&quot; -o &quot;$(GenDir)/samples&quot;" />
    <Exec Command="dotnet &quot;$(CliDll)&quot; generate -s &quot;$(MSBuildThisFileDirectory)Schemas&quot; -o &quot;$(GenDir)/schemas&quot;" />
    <ItemGroup>
      <Compile Include="$(GenDir)/**/*.cs" />
    </ItemGroup>
  </Target>

</Project>